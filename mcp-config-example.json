{
    "mcpServers": {
        "memory-journal-mcp": {
            "command": "docker",
            "args": [
                "run",
                "--rm",
                "-i",
                "--read-only",
                "--cap-drop=ALL",
                "--security-opt=no-new-privileges:true",
                "--tmpfs",
                "/tmp:rw,noexec,nosuid,nodev",
                "-e",
                "DB_PATH",
                "-e",
                "ALLOWED_IO_ROOTS",
                "-e",
                "MEMORY_JOURNAL_MCP_TOOL_FILTER",
                "-e",
                "GITHUB_TOKEN",
                "-v",
                "/absolute/path/data:/app/data:rw,noexec,nosuid,nodev",
                "writenotenow/memory-journal-mcp:latest"
            ],
            "env": {
                "DB_PATH": "/app/data/memory_journal.db",
                "ALLOWED_IO_ROOTS": "/app/data",
                "MEMORY_JOURNAL_MCP_TOOL_FILTER": "full",
                "GITHUB_TOKEN": "ghp_your_token_here"
            }
        }
    }
}
