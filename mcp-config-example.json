{
    "mcpServers": {
        "memory-journal-mcp": {
            "command": "docker",
            "args": [
                "run",
                "--rm",
                "-i",
                "--read-only",
                "--cap-drop=ALL",
                "--security-opt=no-new-privileges:true",
                "--tmpfs",
                "/tmp:rw,noexec,nosuid,nodev",
                "-v",
                "./data:/app/data:rw,noexec,nosuid,nodev",
                "-v",
                "./data/test.db:/app/data/test.db:rw",
                "-v",
                "./data/team.db:/app/data/team.db:rw",
                "-v",
                "./data/test-team.db:/app/data/test-team.db:rw",
                "-v",
                "./data/mcp-audit.jsonl:/app/data/mcp-audit.jsonl:rw",
                "writenotenow/memory-journal-mcp:latest",
                "--digest-interval",
                "1440"
            ],
            "env": {
                "MEMORY_JOURNAL_CONFIG": "",
                "DB_PATH": "/app/data/memory_journal.db",
                "TEST_DB_PATH": "/app/data/test.db",
                "DB_ENCRYPTION_KEY": "",
                "TEAM_DB_PATH": "/app/data/team.db",
                "TEST_TEAM_DB_PATH": "/app/data/test-team.db",
                "ADDITIONAL_TEAM_DBS": "{}",
                "TEAM_AUTHOR": "",
                "TEAM_DEFAULT_ROLE": "denied",
                "TEAM_ADMIN": "",
                "GITHUB_TOKEN": "",
                "DEFAULT_PROJECT_NUMBER": "1",
                "PROJECT_REGISTRY": "{\"my-repo\":{\"path\":\"/path/to/repo\",\"project_number\":1}}",
                "MEMORY_JOURNAL_MCP_TOOL_FILTER": "full",
                "MCP_HOST": "localhost",
                "MCP_AUTH_TOKEN": "",
                "CORS_ORIGIN": "",
                "MCP_RATE_LIMIT_MAX": "100",
                "LOG_LEVEL": "info",
                "MCP_ENABLE_HSTS": "false",
                "OAUTH_ENABLED": "false",
                "OAUTH_ISSUER": "",
                "OAUTH_AUDIENCE": "memory-journal-mcp",
                "OAUTH_JWKS_URI": "",
                "OAUTH_ALLOW_PLAINTEXT_LOOPBACK": "false",
                "CODE_MODE_MAX_RESULT_SIZE": "102400",
                "CODEMODE_INTERNAL_FULL_ACCESS": "false",
                "BRIEFING_ENTRY_COUNT": "3",
                "BRIEFING_SUMMARY_COUNT": "1",
                "BRIEFING_INCLUDE_TEAM": "false",
                "BRIEFING_ISSUE_COUNT": "0",
                "BRIEFING_PR_COUNT": "0",
                "BRIEFING_PR_STATUS": "false",
                "BRIEFING_MILESTONE_COUNT": "3",
                "BRIEFING_WORKFLOW_COUNT": "0",
                "BRIEFING_WORKFLOW_STATUS": "false",
                "BRIEFING_COPILOT_REVIEWS": "false",
                "RULES_FILE_PATH": "",
                "SKILLS_DIR_PATH": "",
                "MEMORY_JOURNAL_WORKFLOW_SUMMARY": "",
                "PROJECT_LINT_CMD": "pnpm run lint",
                "PROJECT_TYPECHECK_CMD": "pnpm run typecheck",
                "PROJECT_BUILD_CMD": "pnpm run build",
                "PROJECT_TEST_CMD": "pnpm test",
                "PROJECT_E2E_CMD": "pnpm run test:e2e",
                "PROJECT_PACKAGE_MANAGER": "npm",
                "PROJECT_HAS_DOCKERFILE": "true",
                "COMMANDER_HITL_FILE_THRESHOLD": "10",
                "COMMANDER_SECURITY_TOOLS": "npm-audit,trivy",
                "COMMANDER_BRANCH_PREFIX": "fix",
                "AUDIT_LOG_PATH": "",
                "AUDIT_REDACT": "true",
                "AUDIT_READS": "false",
                "AUDIT_LOG_MAX_SIZE": "10485760",
                "MCP_METRICS_ENABLED": "true",
                "METRICS_EXPORT": "",
                "AUTO_REBUILD_INDEX": "false",
                "EMBEDDING_MODEL": "Xenova/all-MiniLM-L6-v2",
                "ARCHIVE_OLDER_THAN_DAYS": "0",
                "PRUNE_OLDER_THAN_DAYS": "0",
                "HARD_DELETE_OLDER_THAN_DAYS": "0",
                "PRUNE_IMPORTANCE_THRESHOLD": "0.15",
                "PRUNE_DRY_RUN": "false",
                "PRUNE_EXCLUDE_TAGS": "",
                "PERSIST_METRICS": "false",
                "METRICS_PATH": "/app/data/metrics.json",
                "TRUST_PROXY": "false",
                "PUBLIC_ORIGIN": "",
                "OAUTH_CLOCK_TOLERANCE": "60",
                "ALLOWED_IO_ROOTS": "/app/data",
                "BACKUP_INTERVAL": "0",
                "KEEP_BACKUPS": "5",
                "VACUUM_INTERVAL": "0",
                "REBUILD_INDEX_INTERVAL": "0",
                "DIGEST_INTERVAL": "0",
                "REPORT_INTERVAL": "0",
                "REPORT_WEBHOOK_URL": "",
                "REPORT_WEBHOOK_AUTH": "",
                "REPORT_CONTENT_TYPE": "slack"
            }
        }
    }
}
