{
    "mcpServers": {
        "memory-journal-mcp": {
            "command": "docker",
            "args": [
                "run",
                "--rm",
                "-i",
                "--read-only",
                "--cap-drop=ALL",
                "--security-opt=no-new-privileges:true",
                "--tmpfs",
                "/tmp:rw,noexec,nosuid,nodev",
                "-v",
                "./data:/app/data:rw,noexec,nosuid,nodev",
                "-v",
                "./data/team.db:/app/data/team.db:rw",
                "-v",
                "./data/mcp-audit.jsonl:/app/data/mcp-audit.jsonl:rw",
                "writenotenow/memory-journal-mcp:latest"
            ],
            "env": {
                "MEMORY_JOURNAL_CONFIG": "",
                "DB_PATH": "/app/data/memory_journal.db",
                "TEAM_DB_PATH": "/app/data/team.db",
                "ADDITIONAL_TEAM_DBS": "{}",
                "TEAM_DEFAULT_ROLE": "denied",
                "TEAM_ADMIN": "",
                "DEFAULT_PROJECT_NUMBER": "1",
                "DEFAULT_WORKSPACE_ID": "default",
                "EMBEDDING_MODEL": "Xenova/all-MiniLM-L6-v2",
                "AUTO_REBUILD_INDEX": "false",
                "PORT": "3000",
                "MCP_HOST": "localhost",
                "STATELESS": "false",
                "CORS_ORIGIN": "",
                "MCP_ENABLE_HSTS": "false",
                "MCP_AUTH_TOKEN": "",
                "MCP_AUTH_SCOPES": "",
                "TRUST_PROXY": "false",
                "PUBLIC_ORIGIN": "",
                "OAUTH_ENABLED": "false",
                "AUDIT_LOG_PATH": "",
                "ALLOWED_IO_ROOTS": "/app/data",
                "MEMORY_JOURNAL_MCP_TOOL_FILTER": "full",
                "AUTO_PRUNE_INTERVAL_MINUTES": "1440"
            }
        }
    }
}
