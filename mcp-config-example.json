{
    "mcpServers": {
        "memory-journal-mcp": {
            "command": "docker",
            "args": [
                "run",
                "--rm",
                "-i",
                "--read-only",
                "--cap-drop=ALL",
                "--security-opt=no-new-privileges:true",
                "--tmpfs",
                "/tmp:rw,noexec,nosuid,nodev",
                "-v",
                "./data:/app/data:rw,noexec,nosuid,nodev",
                "-v",
                "./data/team.db:/app/data/team.db:rw",
                "-v",
                "./data/mcp-audit.jsonl:/app/data/mcp-audit.jsonl:rw",
                "writenotenow/memory-journal-mcp:latest"
            ],
            "env": {
                "DB_PATH": "/app/data/memory_journal.db",
                "DB_ENCRYPTION_KEY": "",
                "TEAM_DB_PATH": "/app/data/team.db",
                "ADDITIONAL_TEAM_DBS": "{}",
                "TEAM_AUTHOR": "",
                "TEAM_DEFAULT_ROLE": "denied",
                "TEAM_ADMIN": "",
                "GITHUB_TOKEN": "",
                "GITHUB_HOST": "",
                "DEFAULT_PROJECT_NUMBER": "1",
                "PROJECT_REGISTRY": "",
                "MEMORY_JOURNAL_MCP_TOOL_FILTER": "full",
                "CODE_MODE_MAX_RESULT_SIZE": "",
                "CODEMODE_INTERNAL_FULL_ACCESS": "",
                "ALLOWED_IO_ROOTS": "/app/data",
                "NODE_ENV": "",
                "DEBUG": "",
                "MEMORY_JOURNAL_CONFIG": "",
                "MCP_HOST": "localhost",
                "PORT": "3000",
                "TRANSPORT": "",
                "STATELESS": "false",
                "MCP_AUTH_TOKEN": "",
                "MCP_AUTH_SCOPES": "",
                "CORS_ORIGIN": "",
                "MCP_RATE_LIMIT_MAX": "",
                "MCP_ENABLE_HSTS": "false",
                "LOG_LEVEL": "",
                "TRUST_PROXY": "false",
                "PUBLIC_ORIGIN": "",
                "DEFAULT_WORKSPACE_ID": "default",
                "OAUTH_ENABLED": "false",
                "OAUTH_ISSUER": "",
                "OAUTH_AUDIENCE": "",
                "OAUTH_JWKS_URI": "",
                "OAUTH_ALLOW_PLAINTEXT_LOOPBACK": "",
                "OAUTH_CLOCK_TOLERANCE": "",
                "BRIEFING_IMPORTANCE_THRESHOLD": "",
                "BRIEFING_ENTRY_COUNT": "",
                "BRIEFING_COMMIT_COUNT": "",
                "BRIEFING_SUMMARY_COUNT": "",
                "BRIEFING_INCLUDE_TEAM": "",
                "BRIEFING_MILESTONE_COUNT": "",
                "BRIEFING_ISSUE_COUNT": "",
                "BRIEFING_PR_COUNT": "",
                "BRIEFING_PR_STATUS": "",
                "BRIEFING_WORKFLOW_COUNT": "",
                "BRIEFING_WORKFLOW_STATUS": "",
                "BRIEFING_COPILOT_REVIEWS": "",
                "RULES_FILE_PATH": "",
                "SKILLS_DIR_PATH": "",
                "MEMORY_JOURNAL_WORKFLOW_SUMMARY": "",
                "AUDIT_LOG_PATH": "",
                "AUDIT_REDACT": "",
                "AUDIT_READS": "",
                "AUDIT_LOG_MAX_SIZE": "",
                "PERSIST_METRICS": "",
                "METRICS_PATH": "",
                "METRICS_EXPORT": "",
                "BACKUP_INTERVAL": "",
                "KEEP_BACKUPS": "",
                "VACUUM_INTERVAL": "",
                "REBUILD_INDEX_INTERVAL": "",
                "DIGEST_INTERVAL": "",
                "REPORT_INTERVAL": "",
                "REPORT_WEBHOOK_URL": "",
                "REPORT_WEBHOOK_AUTH": "",
                "REPORT_CONTENT_TYPE": "",
                "EMBEDDING_MODEL": "Xenova/all-MiniLM-L6-v2",
                "AUTO_REBUILD_INDEX": "false",
                "AUTO_PRUNE_INTERVAL_MINUTES": "1440",
                "ARCHIVE_OLDER_THAN_DAYS": "",
                "PRUNE_OLDER_THAN_DAYS": "",
                "HARD_DELETE_OLDER_THAN_DAYS": "",
                "PRUNE_IMPORTANCE_THRESHOLD": "",
                "PRUNE_DRY_RUN": "",
                "PRUNE_EXCLUDE_TAGS": ""
            }
        }
    }
}