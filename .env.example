# memory-journal-mcp Environment Configuration
# Copy this file to .env and customize for your setup
# See README.md for full documentation of these variables

# =============================================================================
# Database
# =============================================================================
# Path to the personal journal SQLite database (CLI: --db)
DB_PATH=./memory_journal.db

# Optional test database override path (used by E2E and integration test suites)
# TEST_DB_PATH=

# Encryption key for SQLCipher encrypted databases (at-rest encryption; also supports MJ_DB_ENCRYPTION_KEY, which takes precedence if both are set)
# DB_ENCRYPTION_KEY=your-secret-key

# Path to the shared team SQLite database (CLI: --team-db)
# SECURITY WARNING: Ensure this path is heavily access-controlled.
# Required to enable team collaboration tools
# TEAM_DB_PATH=./team.db

# Optional test team database override path (used by E2E and integration test suites)
# TEST_TEAM_DB_PATH=

# Additional team database mappings (label -> path) as JSON for cross-team discovery (CLI: --additional-team-dbs)
# ADDITIONAL_TEAM_DBS={"other-team":"/path/to/other-team.db"}

# Author name for team entries when not authenticated via OAuth, or fallback when OAuth identity claims are absent (when OAuth is active, JWT claims [email/preferred_username/sub/subject] take precedence, falling back to TEAM_AUTHOR then 'unknown'; when unauthenticated, fallback order is: TEAM_AUTHOR, OS USERNAME/USER lowercased, or 'unknown')
# TEAM_AUTHOR=Your Name

# Default role for unrecognized team authors: admin, member, viewer, denied (CLI: --team-default-role)
# TEAM_DEFAULT_ROLE=denied

# Bootstrap this author as admin if team_members table is empty (CLI: --team-admin)
# TEAM_ADMIN=


# =============================================================================
# GitHub Integration
# =============================================================================
# Personal access token — scopes: repo, project, read:org
# GITHUB_TOKEN=ghp_your_token_here

# Default GitHub Project number for auto-assignment when creating issues (CLI: --default-project)
# DEFAULT_PROJECT_NUMBER=1

# JSON map of repo names → { path, project_number } for multi-project routing
# Maps repository names to local paths and GitHub Project numbers for multi-repo setups
# PROJECT_REGISTRY={"my-repo":{"path":"/path/to/repo","project_number":1},"other-repo":{"path":"/path/to/other","project_number":5}}

# Session-scoped workspace ID override applied by schema healing on entry creation/mutation tools when workspace_id is omitted or 'default' and not resolved via PROJECT_REGISTRY/CWD (for server-wide read/write default, use DEFAULT_WORKSPACE_ID)
# MCP_WORKSPACE_ID=

# =============================================================================
# Tool Filtering
# =============================================================================
# Control exposed tools across 4 active configuration surfaces (plus display fallback):
#   1. MEMORY_JOURNAL_MCP_TOOL_FILTER — primary environment variable (active startup filtering)
#   2. TOOL_FILTER                    — ConfigManager.rawToolFilter display fallback in initialization.ts ONLY (does NOT activate startup filtering on its own)
#   3. --tool-filter                  — CLI flag (active startup filtering)
#   4. "toolFilter"                   — key in memory-journal.config.{yaml,yml,json} (active startup filtering)
#   5. tool_filter                    — parameter in update_configuration MCP tool (live runtime filtering)
# Meta-group presets: full (default), starter, essential, readonly  |  Single-tool group: codemode (mj_execute_code only)
# Groups:    core, search, analytics, relationships, io, admin, github, git, backup, team, codemode
# Exclusion: -github,-analytics  Re-enable: +tool_name
# MEMORY_JOURNAL_MCP_TOOL_FILTER=full

# Maximum size in bytes for mj_execute_code result payload (CLI: --codemode-max-result-size)
# CODE_MODE_MAX_RESULT_SIZE=102400

# Bypass tool filter constraints within the Code Mode sandbox (CLI: --codemode-internal-full-access)
# When true, mj_execute_code can call all tool groups regardless of the active tool filter.
# Note: --codemode-internal-full-access defaults to false on the CLI (serve) and true when buildServerOptions is invoked programmatically without CLI defaults.
# CODEMODE_INTERNAL_FULL_ACCESS=false

# =============================================================================
# Security & IO Boundaries
# =============================================================================
# Critical Security Boundary: Comma-separated absolute paths granting filesystem access to Code Mode and export tools
# SECURITY WARNING: Never use generic directories like / or /usr. Fail-closed by default.
# ALLOWED_IO_ROOTS=/path/to/your/git/repo

# Enable/disable autonomous MCP tool and parameter healing/interception (CLI: --no-agent-healing to disable)
# MCP_AGENT_HEALING=true

# Disable automatic MCP/CLI agent issue logging to logs/agent-issues.jsonl (set to "true" in test suites)
# DISABLE_ISSUE_LOGGING=false

# Maximum array/object elements allowed in tool input arguments (0 = disabled) (CLI: --max-tool-input-elements)
# MAX_TOOL_INPUT_ELEMENTS=25000

# =============================================================================
# Server Configuration
# =============================================================================
# Environment
# NODE_ENV=production

# Include details.internal_message in structured formatHandlerError() responses (use LOG_LEVEL=debug for verbose logging)
# DEBUG=true
# Path to configuration file (.yaml, .yml, .json) (CLI: --config)
# MEMORY_JOURNAL_CONFIG=./memory-journal.config.yaml

# Host to bind the HTTP/SSE server to (use 0.0.0.0 for all interfaces; CLI: --server-host, fallback env: HOST)
# MCP_HOST=localhost

# Bind port for HTTP transport (CLI: --port)
# PORT=3000

# Transport type: stdio or http (CLI: --transport)
# TRANSPORT=stdio

# Use stateless HTTP mode (no session management) (CLI: --stateless)
# STATELESS=false


# Bearer token for HTTP transport authentication (CLI: --auth-token)
# MCP_AUTH_TOKEN=your-secret-token

# Comma-separated scopes granted to static Bearer token (MCP_AUTH_TOKEN) requests (default: read ['read'], CLI: --auth-scopes)
# Note: Static bearer middleware reads process.env.MCP_AUTH_SCOPES at request time (--auth-scopes bridges to process.env.MCP_AUTH_SCOPES on startup).
# MCP_AUTH_SCOPES=read

# Allowed CORS origins for HTTP transport, comma-separated (default: none) (CLI: --cors-origin, fallback env: MCP_CORS_ORIGIN)
# CORS_ORIGIN=https://your-client.example.com

# Max requests per minute per client IP for HTTP transport (default: 100)
# MCP_RATE_LIMIT_MAX=100

# Enable HSTS security header on HTTP responses (CLI: --enable-hsts)
# MCP_ENABLE_HSTS=false

# Log verbosity: debug, info, notice, warning, error, critical (CLI: --log-level)
LOG_LEVEL=info

# Set to true if the server is running behind a reverse proxy (CLI: --trust-proxy)
# TRUST_PROXY=false

# Override the public origin used in output URLs instead of relying on the Request object (CLI: --public-origin)
# PUBLIC_ORIGIN=

# Default workspace ID for isolating memory journal data (multi-tenancy) (CLI: --default-workspace-id)
# DEFAULT_WORKSPACE_ID=default
# =============================================================================
# OAuth 2.1 Authentication (HTTP transport only, opt-in)
# =============================================================================
# Enable OAuth 2.1 authentication (CLI: --oauth-enabled)
# OAUTH_ENABLED=false
# OAuth issuer URL (CLI: --oauth-issuer)
# OAUTH_ISSUER=https://auth.example.com/realms/mcp
# OAuth audience (CLI: --oauth-audience)
# OAUTH_AUDIENCE=memory-journal-mcp
# OAuth JWKS URI (default: ${OAUTH_ISSUER}/.well-known/jwks.json) (CLI: --oauth-jwks-uri)
# OAUTH_JWKS_URI=https://auth.example.com/realms/mcp/protocol/openid-connect/certs
# Allow plaintext loopback OAuth issuer (CLI: --oauth-allow-plaintext-loopback)
# OAUTH_ALLOW_PLAINTEXT_LOOPBACK=false
# OAuth clock tolerance in seconds (default: 60) (CLI: --oauth-clock-tolerance)
# OAUTH_CLOCK_TOLERANCE=60

# =============================================================================
# Briefing Configuration (memory://briefing content)
# =============================================================================
# Minimum importance score (0.0-1.0) required for an entry to be included in the briefing graph context (CLI: --briefing-importance-threshold)
# BRIEFING_IMPORTANCE_THRESHOLD=0.3

# Number of journal entries to include in the briefing (CLI: --briefing-entries)
# BRIEFING_ENTRY_COUNT=3

# Number of commits to include in the briefing context (CLI: --briefing-commits)
# BRIEFING_COMMIT_COUNT=3

# Number of session summaries to list in briefing (CLI: --briefing-summaries)
# BRIEFING_SUMMARY_COUNT=1

# Include team DB entries in briefing output (CLI: --briefing-include-team)
# BRIEFING_INCLUDE_TEAM=false

# Number of milestones to list in briefing; 0 = hide section (CLI: --briefing-milestones)
# BRIEFING_MILESTONE_COUNT=3

# Number of issues to list in briefing; 0 = count only (CLI: --briefing-issues)
# BRIEFING_ISSUE_COUNT=0

# Number of PRs to list in briefing; 0 = count only (CLI: --briefing-prs, --briefing-pr-count)
# BRIEFING_PR_COUNT=0

# Show PR status breakdown (open/merged/closed) (CLI: --briefing-pr-status)
# BRIEFING_PR_STATUS=false

# Number of workflow runs to list in briefing; 0 = status only (CLI: --briefing-workflows)
# BRIEFING_WORKFLOW_COUNT=0

# Show workflow status breakdown (CLI: --briefing-workflow-status)
# BRIEFING_WORKFLOW_STATUS=false

# Aggregate Copilot review state in briefing (CLI: --briefing-copilot)
# BRIEFING_COPILOT_REVIEWS=false

# Thresholds for memory://staleness project classification
# STALENESS_ACTIVE_HOURS=24
# STALENESS_RECENT_DAYS=7
# STALENESS_STALE_DAYS=30


# =============================================================================
# Agent Context (Rules & Skills)
# =============================================================================
# Path to a rules/GEMINI.md file stored in briefingConfig and powering memory://rules (CLI: --rules-file)
# RULES_FILE_PATH=/path/to/RULES.md

# Path to a skills directory stored in briefingConfig and powering memory://skills (CLI: --skills-dir)
# SKILLS_DIR_PATH=/path/to/skills

# Free-text workflow summary shown in memory://workflows (CLI: --workflow-summary)
# MEMORY_JOURNAL_WORKFLOW_SUMMARY=/deploy: production deploy | /audit: security scan

# =============================================================================
# Audit Logging & Metrics
# =============================================================================
# Enable JSONL audit logging to a file path, or "stderr" for container mode (default: disabled, CLI: --audit-log; `admin audit` CLI also supports MEMORY_JOURNAL_AUDIT_LOG as a fallback)
# AUDIT_LOG_PATH=./logs/mcp-audit.jsonl

# Redact tool arguments from audit entries (CLI: --no-audit-redact to disable)
# AUDIT_REDACT=true

# Log read-scoped tool calls in addition to write/admin (CLI: --audit-reads)
# AUDIT_READS=false

# Maximum audit log file size in bytes before rotation (CLI: --audit-log-max-size)
# AUDIT_LOG_MAX_SIZE=10485760



# Periodically persist metrics state to disk for long-term trend analysis (CLI: --persist-metrics)
# PERSIST_METRICS=false

# Persist accumulator metrics across restarts to a JSON file (default: <db-path>_metrics.json, CLI: --metrics-path)
# METRICS_PATH=./data/metrics.json

# Metrics export format, e.g. prometheus (CLI: --metrics-export)
# METRICS_EXPORT=prometheus

# Dedicated port (CLI: --metrics-port) and bind host (env-only, default: 127.0.0.1) for Prometheus metrics scraping
# MJ_METRICS_PORT=9465
# MJ_METRICS_HOST=127.0.0.1

# =============================================================================
# Automated Scheduling
# =============================================================================
# Automated backup interval in minutes, HTTP only (0 = disabled) (CLI: --backup-interval)
# BACKUP_INTERVAL=0

# Max backups to retain during automated cleanup (CLI: --keep-backups)
# KEEP_BACKUPS=5

# Database optimize interval in minutes, HTTP only (0 = disabled) (CLI: --vacuum-interval)
# VACUUM_INTERVAL=0

# Vector index rebuild interval in minutes, HTTP only (0 = disabled) (CLI: --rebuild-index-interval)
# REBUILD_INDEX_INTERVAL=0

# Analytics digest interval in minutes, HTTP only (0 = disabled; recommended: 1440 for daily) (CLI: --digest-interval)
# DIGEST_INTERVAL=0

# Scheduled report generation interval in minutes, HTTP only (0 = disabled) (CLI: --report-interval)
# REPORT_INTERVAL=0

# Webhook URL for report delivery (POST) (CLI: --report-webhook-url)
# REPORT_WEBHOOK_URL=

# Optional Authorization header value for the report webhook (CLI: --report-webhook-auth)
# REPORT_WEBHOOK_AUTH=

# Webhook payload format: slack, discord, or json (CLI: --report-content-type)
# REPORT_CONTENT_TYPE=slack

# Allow plaintext HTTP webhook URLs for local testing only (SSRF guard requires HTTPS by default)
# ALLOW_INSECURE_WEBHOOK_HTTP=false

# =============================================================================
# Vector Index
# =============================================================================
# HuggingFace Feature Extraction pipeline model used for semantic search embeddings (CLI: --embedding-model)
# Default is Xenova/all-MiniLM-L6-v2. Use smaller models for speed or larger for accuracy.
# EMBEDDING_MODEL=Xenova/all-MiniLM-L6-v2

# Rebuild the semantic search vector index on server startup (CLI: --auto-rebuild-index)
# AUTO_REBUILD_INDEX=false

# =============================================================================
# Auto-Prune (Garbage Collection)
# =============================================================================
# Automated garbage collection interval in minutes, HTTP only (0 = disabled) (CLI: --auto-prune-interval)
# AUTO_PRUNE_INTERVAL_MINUTES=0



# Archive active entries older than N days with importance below threshold
# 0 disables archiving (default); 14 is the standard retention window when enabled. (CLI: --archive-older-than-days)
# ARCHIVE_OLDER_THAN_DAYS=0

# Soft-delete entries older than N days with importance below threshold on startup
# Creates a safety backup before pruning. 0 disables pruning (default); 30 is the standard retention window when enabled. (CLI: --prune-older-than-days)
# PRUNE_OLDER_THAN_DAYS=0

# Permanently delete soft-deleted entries that have been dead for N days
# Set days to 0 to disable. (CLI: --hard-delete-older-than-days)
# HARD_DELETE_OLDER_THAN_DAYS=0

# Importance score threshold (0.0-1.0) — entries scoring below this are pruned (CLI: --prune-importance-threshold)
# PRUNE_IMPORTANCE_THRESHOLD=0.15

# Preview auto-prune candidates without mutating the database (CLI: --prune-dry-run)
# PRUNE_DRY_RUN=false

# Comma-separated list of tags to exempt from auto-pruning (CLI: --prune-exclude-tags)
# PRUNE_EXCLUDE_TAGS=
