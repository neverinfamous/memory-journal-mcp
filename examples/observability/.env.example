# Generate a cryptographically random token for MCP HTTP + Prometheus /metrics scraping:
#   openssl rand -hex 32
# memory-journal-mcp rejects default placeholder tokens on non-loopback binds.
MCP_AUTH_TOKEN=replace-with-openssl-rand-hex-32

# Grafana UI admin password
GF_ADMIN_PASSWORD=admin

# Reported hostname for Datadog OpenMetrics Autodiscovery v2 (used in datadog-labels.yml)
DD_REPORTED_HOSTNAME=memory-journal-mcp-host
